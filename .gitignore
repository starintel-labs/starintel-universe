# Coverage / reports are generated per-run; keep the tree, ignore contents
/reports/integration/*/
!/reports/integration/.gitkeep
!/reports/integration/README.org

# Node
node_modules/

# Test scratch
/tests/tmp/
/tmp/
*.log
