# PKGBUILD-vanta — generated by packaging/arch/stage.sh into a versioned copy.
# This template is not directly consumable by makepkg: stage.sh substitutes
# __UNIVERSE_VERSION__ (release_version() from packaging/common.sh) and the
# staged payload is assembled from the same collect_staging tree by
# packaging/arch/build-arch.sh (docker archlinux:base, staged input mounted
# at /input).

# Maintainer: StarIntel <nsaspy@fedora.email>
pkgname=vanta
pkgver=__UNIVERSE_VERSION__
pkgrel=1
pkgdesc="VANTA - the StarIntel agent distribution (wraps upstream Zara)"
arch=(x86_64)
url="https://git.starintel.actor/starintel/starintel-universe"
license=('GPL-3.0-only' 'MIT')
depends=(python)
makedepends=()
checkdepends=()
optdepends=()
source=()   # empty: files are staged via packaging/arch/stage.sh
noextract=()
validpgpkeys=()
options=(!debug !strip)   # payload is prebuilt; no debugedit/fakeroot-strip pass

package() {
  # the staged payload is mounted at /input (see build-arch.sh); the PKGBUILD
  # itself lives beside it, not inside it.
  cp -a --no-preserve=ownership /input/vanta/payload/. "$pkgdir"/
}
